# Copie para .env e preencha. Nunca versione o .env.

# Obrigatórias: Oracle BI Publisher
BIP_HOST=https://<sua-instancia>.fa.ocs.oraclecloud.com
BIP_REPORT_PATH=/Custom/<sua_pasta>/RunSQL.xdo
BIP_USER=
BIP_PASS=

# IA local (Ollama). Instale em https://ollama.com e rode: ollama pull qwen2.5-coder:3b
# Opcionais (descomente só para trocar o padrão do config.py):
# OLLAMA_URL=http://127.0.0.1:11434
# LLM_MODELO=qwen2.5-coder:3b
# OLLAMA_TIMEOUT=600
# OLLAMA_NUM_CTX=8192
# OLLAMA_KEEP_ALIVE=30m
# OLLAMA_NUM_THREAD=0
# OLLAMA_THINK=false
# OLLAMA_PERMITIR_REMOTO=false

# Opcionais do sistema:
# BIP_TIMEOUT=60
# MAX_ROWS=200
# TENTATIVAS_CORRECAO=1
# DEMO_OFFLINE=false
